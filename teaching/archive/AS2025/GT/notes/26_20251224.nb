Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]O3", "[", 
    RowBox[{"l_", ",", "\[Theta]_"}], "]"}], ":=", 
   RowBox[{"ChebyshevU", "[", 
    RowBox[{
     RowBox[{"2", "l"}], ",", 
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}]}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{":=", 
    FractionBox[
     RowBox[{"Sin", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"l", "+", 
         FractionBox["1", "2"]}], ")"}], "\[Theta]"}], "]"}], 
     RowBox[{"Sin", "[", 
      RowBox[{
       FractionBox["1", "2"], "\[Theta]"}], "]"}]]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Chi]O3Red", "[", "l_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Chi]O3", "[", 
     RowBox[{"l", ",", "#"}], "]"}], "&"}], "/@", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"2", 
      RowBox[{"\[Pi]", "/", "3"}]}], ",", "\[Pi]", ",", 
     RowBox[{"\[Pi]", "/", "2"}], ",", "\[Pi]"}], "}"}]}]}], "\n", 
 RowBox[{
  RowBox[{"\[Chi]O3Full", "[", "l_", "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "l"]}], "}"}], ",", 
      RowBox[{"\[Chi]O3Red", "[", "l", "]"}]}], "]"}], ",", "1"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Chi]", "[", 
   RowBox[{"name_", ",", 
    RowBox[{"G_", ":", "Oh"}]}], "]"}], ":=", 
  RowBox[{
