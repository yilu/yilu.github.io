Cell[BoxData[
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        RowBox[{"Cos", "[", 
         SubscriptBox["k", "x"], "]"}], "2"]}], " ", 
      RowBox[{"Cos", "[", 
       SubscriptBox["k", "y"], "]"}]}], "+", 
     RowBox[{
      RowBox[{"Cos", "[", 
       SubscriptBox["k", "x"], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", 
        SubscriptBox["k", "y"]}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"Cos", "[", 
       SubscriptBox["k", "y"], "]"}], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", 
        SubscriptBox["k", "x"], "]"}], "2"]}]}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["k", "x"], ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["k", "y"], ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"MeshFunctions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"#3", "&"}], ",", 
      RowBox[{"#3", "&"}]}], "}"}]}], ",", 
   RowBox[{"Mesh", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "0", "}"}], ",", 
      RowBox[{"{", "0", "}"}]}], "}"}]}], ",", 
   RowBox[{"MeshStyle", "->", 
    RowBox[{"Opacity", "[", 
     RowBox[{"0.5", ",", "Black"}], "]"}]}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "150"}]}], "]"}]], "Input",
