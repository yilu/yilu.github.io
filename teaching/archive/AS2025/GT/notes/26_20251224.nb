Cell[BoxData[
 RowBox[{
  RowBox[{"DecomposeToIrreps", "[", 
   RowBox[{"G_Association", ",", "char__"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "multi", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"multi", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", 
          RowBox[{"Total", "[", 
           RowBox[{"G", "[", "\"\<ConjugacyClassSizes\>\"", "]"}], "]"}]], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"G", "[", "\"\<ConjugacyClassSizes\>\"", "]"}], 
            RowBox[{
             RowBox[{"G", "[", "\"\<CharacterTable\>\"", "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ")"}], ".", "char"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"G", "[", "\"\<CharacterTable\>\"", "]"}], "]"}]}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     
     RowBox[{"multi", "=", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"multi", " ", 
         RowBox[{"G", "[", "\"\<Irreps\>\"", "]"}]}], ",", "0"}], "]"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "multi", "]"}], ">", "1"}], ",", 
       RowBox[{"multi", "/.", 
        RowBox[{"List", "->", "CirclePlus"}]}], ",", 
       RowBox[{"multi", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
