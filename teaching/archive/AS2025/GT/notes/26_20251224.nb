     SubscriptBox["k", "y"], ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"MeshFunctions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"#3", "&"}], ",", 
      RowBox[{"#3", "&"}]}], "}"}]}], ",", 
   RowBox[{"Mesh", "->", 
    RowBox[{"{", 
